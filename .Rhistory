source("~/Documents/Computational/ChIP-seq/Template/scripts/calculate_coverage.R")
# Installiert BSgenome und das benötigte dm6-Genom über Bioconductor
renv::install("bioc::BSgenome")
if (!requireNamespace("BiocManager", quietly = TRUE)) {
renv::install("BiocManager")
}
BiocManager::install("BSgenome.Dmelanogaster.UCSC.dm6")
# 1. DiffBind & Co. in renv installieren
renv::install("bioc::DiffBind")
rm -rf .Rprofile renv.lock
BiocManager::install("memes")
