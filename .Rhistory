source("~/Documents/Computational/ChIP-seq/Template/scripts/calculate_coverage.R")
# 1. renv neu initialisieren (nutzt die bereits installierten Conda-Pakete)
renv::init(bare = TRUE)
# 2. Aktivierung erzwingen
renv::activate()
# 3. Den aktuellen Zustand der Conda-R-Pakete in renv übernehmen
#    (Erkennt alle geladenen / installierten Pakete)
renv::hydrate()
q()
renv::init(bare = TRUE)
q()
renv::hydrate()
renv::hydrate()
renv::install("bioc::memes")
renv::snapshot(confirm = FALSE)
q()
